APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=liceo_innovarte
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Brevo SMTP (Hito 5a) — credenciales reales solo en .env local/producción,
# nunca en este archivo ni commiteadas.
#
# MAIL_HOST: usar smtp-relay.sendinblue.com, NO smtp-relay.brevo.com. Verificado
# en vivo (2026-08-09): el certificado TLS que responde en smtp-relay.brevo.com
# (al menos desde redes geo-ruteadas a "southamerica-east") solo trae en su SAN
# los nombres *.sendinblue.com, nunca brevo.com -- la verificación estricta de
# hostname de PHP/Symfony Mailer rechaza la conexión aunque el certificado sea
# legítimo (Let's Encrypt, vigente). smtp-relay.sendinblue.com sí conecta limpio.
#
# MAIL_USERNAME: NO es el correo de la cuenta (ej. notificaciones@...) -- es el
# "SMTP login" que Brevo genera aparte, formato tipo `xxxxxxxxx@smtp-brevo.com`.
# Se confirma en el panel de Brevo, SMTP & API → SMTP. Usar el correo de cuenta
# como username da 535 5.7.8 Authentication failed, con la key correcta.
#
# MAIL_PASSWORD: la SMTP key (empieza con "xsmtpsib-"), no la contraseña de la
# cuenta. MAIL_FROM_ADDRESS sí puede ser el correo institucional real, aunque
# sea distinto del username -- son cosas separadas.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp-relay.sendinblue.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="notificaciones@liceoinnovarte.edu.co"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
